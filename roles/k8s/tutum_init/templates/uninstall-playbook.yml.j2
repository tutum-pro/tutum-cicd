---
# Tutum Platform - Kubernetes Uninstallation Playbook
# Generated by tutum_pro.cicd.k8s.tutum_init
#
# Usage:
#   ansible-playbook -i {{ k8s_tutum_init_inventory_path }}/{{ k8s_tutum_init_inventory_file }} {{ k8s_tutum_init_uninstall_playbook_file }}
#
# WARNING: This will remove all Tutum Platform components from the cluster!
# Data stored in PostgreSQL will be DELETED if using embedded/cnpg mode.

- name: Uninstall Tutum Platform from Kubernetes
  hosts: k8s_controllers
  gather_facts: false

  vars:
    # Force state to absent for all components
    k8s_tutum_engine_state: "absent"
    k8s_tutum_csi_state: "absent"
{% if k8s_tutum_init_db_mode == "embedded" %}
    k8s_tutum_postgres_state: "absent"
{% elif k8s_tutum_init_db_mode == "cnpg" %}
    k8s_tutum_cnpg_state: "absent"
{% endif %}

  roles:
{% if k8s_tutum_init_generate_csi %}
    # Remove CSI Driver first (to allow volumes to be cleaned up)
    - role: tutum_pro.cicd.k8s.tutum_csi
{% endif %}

{% if k8s_tutum_init_generate_engine %}
    # Remove Tutum Engine
    - role: tutum_pro.cicd.k8s.tutum_engine
{% endif %}

{% if k8s_tutum_init_db_mode == "embedded" and k8s_tutum_init_generate_postgres %}
    # Remove embedded PostgreSQL
    - role: tutum_pro.cicd.k8s.tutum_postgres
{% elif k8s_tutum_init_db_mode == "cnpg" and k8s_tutum_init_generate_postgres %}
    # Remove CloudNativePG cluster
    - role: tutum_pro.cicd.k8s.tutum_cnpg
{% endif %}

  post_tasks:
    - name: Delete namespace (optional - uncomment if you want to remove the namespace)
      kubernetes.core.k8s:
        state: absent
        api_version: v1
        kind: Namespace
        name: "{{ '{{' }} k8s_tutum_namespace {{ '}}' }}"
      when: k8s_tutum_delete_namespace | default(false) | bool

    - name: Display uninstallation summary
      ansible.builtin.debug:
        msg:
          - "=========================================="
          - "  Tutum Platform Uninstallation Complete!"
          - "=========================================="
          - ""
          - "Removed components:"
{% if k8s_tutum_init_generate_csi %}
          - "  - CSI Driver"
{% endif %}
{% if k8s_tutum_init_generate_engine %}
          - "  - Tutum Engine"
{% endif %}
{% if k8s_tutum_init_db_mode == "embedded" and k8s_tutum_init_generate_postgres %}
          - "  - PostgreSQL (embedded)"
{% elif k8s_tutum_init_db_mode == "cnpg" and k8s_tutum_init_generate_postgres %}
          - "  - CloudNativePG cluster"
{% endif %}
          - ""
          - "Namespace {{ '{{' }} k8s_tutum_namespace {{ '}}' }} was {{ '{{' }} 'deleted' if k8s_tutum_delete_namespace | default(false) | bool else 'preserved' {{ '}}' }}."
          - ""
          - "To also delete the namespace, run:"
          - "  ansible-playbook -i {{ k8s_tutum_init_inventory_path }}/{{ k8s_tutum_init_inventory_file }} {{ k8s_tutum_init_uninstall_playbook_file }} -e k8s_tutum_delete_namespace=true"
