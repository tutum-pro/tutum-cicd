#!/bin/bash
# Tutum Platform - Load Container Images
# Generated by tutum_offline_bundle role
#
# This script loads all container images from tar files.
# Run this script on the air-gapped system after extracting the bundle.
# Supports both Docker and Podman.

set -e

# Container runtime (auto-detect)
RUNTIME="{{ k8s_tutum_offline_container_runtime }}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGES_DIR="${SCRIPT_DIR}/../images"

echo "==========================================="
echo "  Tutum Platform - Load Container Images"
echo "==========================================="
echo ""
echo "Container runtime: ${RUNTIME}"
echo ""

if ! command -v "${RUNTIME}" &> /dev/null; then
    echo "ERROR: ${RUNTIME} is not installed or not in PATH"
    echo "Please install ${RUNTIME} or set RUNTIME environment variable to 'docker' or 'podman'"
    exit 1
fi

echo "Loading images from: ${IMAGES_DIR}"
echo ""

# Load original images
{% for image in _required_images %}
echo "Loading {{ image.component }}..."
"${RUNTIME}" load -i "${IMAGES_DIR}/{{ image.component }}.tar"
{% endfor %}

{% if k8s_tutum_offline_internal_registry | length > 0 and k8s_tutum_offline_save_retagged | bool %}
# Load retagged images (for internal registry)
echo ""
echo "Loading retagged images for internal registry..."
{% for image in _required_images %}
if [ -f "${IMAGES_DIR}/{{ image.component }}-internal.tar" ]; then
    echo "Loading {{ image.component }}-internal..."
    "${RUNTIME}" load -i "${IMAGES_DIR}/{{ image.component }}-internal.tar"
fi
{% endfor %}
{% endif %}

echo ""
echo "==========================================="
echo "  All images loaded successfully!"
echo "==========================================="
echo ""
echo "Loaded images:"
"${RUNTIME}" images | grep -E "(tutum|cnpg|csi)" | head -20 || true
