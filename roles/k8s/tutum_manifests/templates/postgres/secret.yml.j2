---
apiVersion: v1
kind: Secret
metadata:
  name: tutum-postgres-secret
  namespace: {{ k8s_tutum_namespace }}
  labels:
    app.kubernetes.io/name: tutum-postgres
    app.kubernetes.io/component: database
    app.kubernetes.io/part-of: tutum
type: Opaque
stringData:
{% if k8s_tutum_postgres_image_type == 'openshift' %}
  # OpenShift/sclorg PostgreSQL image environment variables
  POSTGRESQL_USER: "{{ k8s_tutum_db_user }}"
  POSTGRESQL_PASSWORD: "{{ k8s_tutum_db_password }}"
  POSTGRESQL_DATABASE: "{{ k8s_tutum_db_name }}"
{% else %}
  # Standard PostgreSQL image environment variables
  POSTGRES_USER: "{{ k8s_tutum_db_user }}"
  POSTGRES_PASSWORD: "{{ k8s_tutum_db_password }}"
  POSTGRES_DB: "{{ k8s_tutum_db_name }}"
{% endif %}
