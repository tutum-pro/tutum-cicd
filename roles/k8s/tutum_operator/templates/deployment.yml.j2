---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tutum-operator
  namespace: {{ k8s_tutum_namespace }}
  labels:
    app.kubernetes.io/name: tutum-operator
    app.kubernetes.io/version: "{{ k8s_tutum_operator_version }}"
    app.kubernetes.io/managed-by: ansible
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: tutum-operator
  template:
    metadata:
      labels:
        app.kubernetes.io/name: tutum-operator
        app.kubernetes.io/version: "{{ k8s_tutum_operator_version }}"
    spec:
      serviceAccountName: tutum-operator
{% if k8s_tutum_registry_url | default('') | length > 0 %}
      imagePullSecrets:
        - name: {{ k8s_tutum_registry_secret_name }}
{% endif %}
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: manager
          image: {{ k8s_tutum_operator_image }}:{{ k8s_tutum_operator_version }}
          imagePullPolicy: IfNotPresent
          args:
            - "--tutum-engine-url={{ k8s_tutum_engine_url }}"
            - "--sync-interval={{ k8s_tutum_operator_sync_interval }}"
            - "--zap-log-level={{ k8s_tutum_operator_log_level }}"
{% if k8s_tutum_operator_watch_namespaces | default('') | length > 0 %}
            - "--watch-namespaces={{ k8s_tutum_operator_watch_namespaces }}"
{% endif %}
          env:
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
          ports:
            - name: health
              containerPort: 8081
              protocol: TCP
            - name: metrics
              containerPort: 8080
              protocol: TCP
            - name: webhook
              containerPort: 8082
              protocol: TCP
          livenessProbe:
            httpGet:
              path: /healthz
              port: health
            initialDelaySeconds: 15
            periodSeconds: 20
          readinessProbe:
            httpGet:
              path: /readyz
              port: health
            initialDelaySeconds: 5
            periodSeconds: 10
          resources:
            requests:
              cpu: "{{ k8s_tutum_operator_resources.requests.cpu }}"
              memory: "{{ k8s_tutum_operator_resources.requests.memory }}"
            limits:
              cpu: "{{ k8s_tutum_operator_resources.limits.cpu }}"
              memory: "{{ k8s_tutum_operator_resources.limits.memory }}"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
      nodeSelector:
        kubernetes.io/os: linux
      terminationGracePeriodSeconds: 10
---
# Service for webhook endpoint - allows Tutum Engine to send certificate change notifications
apiVersion: v1
kind: Service
metadata:
  name: tutum-operator-webhook
  namespace: {{ k8s_tutum_namespace }}
  labels:
    app.kubernetes.io/name: tutum-operator
    app.kubernetes.io/component: webhook
    app.kubernetes.io/managed-by: ansible
spec:
  selector:
    app.kubernetes.io/name: tutum-operator
  ports:
    - name: webhook
      port: 8082
      targetPort: webhook
      protocol: TCP
  type: ClusterIP
