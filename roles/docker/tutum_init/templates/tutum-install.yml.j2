---
# Tutum Platform - Installation Playbook
# Generated by tutum_pro.cicd.docker.tutum_init
#
# Usage:
#   ansible-playbook -i {{ tutum_init_inventory_path }}/{{ tutum_init_inventory_file }} {{ tutum_init_playbook_file }}
#
{% if tutum_init_become %}
# With sudo password:
#   ansible-playbook -i {{ tutum_init_inventory_path }}/{{ tutum_init_inventory_file }} {{ tutum_init_playbook_file }} --ask-become-pass
#
{% endif %}
# With vault (for production):
#   ansible-playbook -i {{ tutum_init_inventory_path }}/{{ tutum_init_inventory_file }} {{ tutum_init_playbook_file }} --ask-vault-pass

- name: Install Tutum Platform (Docker)
  hosts: docker_servers

  # All variables are defined in inventory file (docker_servers:vars section)
  # This allows easy customization without modifying the playbook

  roles:
{% if tutum_init_db_mode != 'external' or not tutum_init_external_db_url %}
    # PostgreSQL database (embedded)
    - role: tutum_pro.cicd.docker.tutum_postgres
{% endif %}

    # Tutum Engine (core service)
    - role: tutum_pro.cicd.docker.tutum_engine

    # Docker Volume Plugin
    - role: tutum_pro.cicd.docker.tutum_plugin

    # Admin CLI
    - role: tutum_pro.cicd.docker.tutum_cli

  post_tasks:
    - name: Display installation summary
      ansible.builtin.debug:
        msg:
          - "=========================================="
          - "  Tutum Platform Installation Complete!"
          - "=========================================="
          - ""
          - "Services:"
          - "  - REST API: http://{{ '{{' }} ansible_host | default(inventory_hostname) {{ '}}' }}:{{ '{{' }} docker_tutum_rest_port {{ '}}' }}"
          - "  - gRPC API: {{ '{{' }} ansible_host | default(inventory_hostname) {{ '}}' }}:{{ '{{' }} docker_tutum_grpc_port {{ '}}' }}"
{% if tutum_init_db_mode != 'external' or not tutum_init_external_db_url %}
          - "  - PostgreSQL: {{ '{{' }} ansible_host | default(inventory_hostname) {{ '}}' }}:{{ '{{' }} docker_tutum_db_port {{ '}}' }}"
{% endif %}
          - ""
          - "To manage certificates, use tutum-admin-cli:"
          - "  docker exec -it tutum-admin-cli tutum-cli certificate list"
          - ""
          - "IMPORTANT: Save your security keys!"
          - "  TUTUM_MASTER_KEY and TUTUM_JWT_SECRET"
