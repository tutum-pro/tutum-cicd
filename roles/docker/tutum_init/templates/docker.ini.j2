# Tutum Platform - Docker Inventory
# Generated by tutum_pro.cicd.docker.tutum_init
#
# This inventory file defines target hosts for Tutum Platform deployment.
# Modify the hosts and connection settings as needed for your environment.

[docker_servers]
{{ tutum_init_target_host }} ansible_connection={{ tutum_init_ansible_connection }} ansible_python_interpreter={{ tutum_init_ansible_python_interpreter }}

# To add remote hosts, use the following format:
# server1.example.com ansible_host=192.168.1.10 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa
# server2.example.com ansible_host=192.168.1.11 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa

[docker_servers:vars]
# Common variables for all docker_servers
ansible_become=true

# Tutum Engine configuration
docker_tutum_engine_version={{ tutum_init_engine_version }}
docker_tutum_rest_port={{ tutum_init_rest_port }}
docker_tutum_grpc_port={{ tutum_init_grpc_port }}

# Database configuration
{% if tutum_init_db_mode == 'external' and tutum_init_external_db_url %}
docker_tutum_external_db_url={{ tutum_init_external_db_url }}
{% else %}
docker_tutum_db_name={{ tutum_init_db_name }}
docker_tutum_db_user={{ tutum_init_db_user }}
docker_tutum_db_password={{ tutum_init_db_password }}
docker_tutum_db_port={{ tutum_init_db_port }}
{% endif %}

# Security keys (IMPORTANT: Change these in production!)
# Generate with: openssl rand -base64 32 | head -c 32
{% if tutum_init_master_key %}
docker_tutum_master_key={{ tutum_init_master_key }}
{% else %}
# docker_tutum_master_key=YourSecure32CharacterKeyHere!!!
{% endif %}
{% if tutum_init_jwt_secret %}
docker_tutum_jwt_secret={{ tutum_init_jwt_secret }}
{% else %}
# docker_tutum_jwt_secret=AnotherSecure32CharJwtSecret!!
{% endif %}

# Plugin configuration
docker_tutum_plugin_version={{ tutum_init_plugin_version }}

# CLI configuration
docker_tutum_cli_version={{ tutum_init_cli_version }}
