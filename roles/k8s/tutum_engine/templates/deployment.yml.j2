---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tutum-engine
  namespace: {{ k8s_tutum_namespace }}
  labels:
    app.kubernetes.io/name: tutum-engine
    app.kubernetes.io/component: backend
    app.kubernetes.io/version: "{{ k8s_tutum_engine_version }}"
    app.kubernetes.io/managed-by: ansible
spec:
  replicas: {{ k8s_tutum_engine_replicas }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: tutum-engine
      app.kubernetes.io/component: backend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: tutum-engine
        app.kubernetes.io/component: backend
        app.kubernetes.io/version: "{{ k8s_tutum_engine_version }}"
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "{{ k8s_tutum_engine_metrics_port }}"
        prometheus.io/path: "/metrics"
    spec:
      serviceAccountName: tutum-engine
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        fsGroup: 1000
      containers:
        - name: tutum-engine
          image: {{ k8s_tutum_engine_image }}:{{ k8s_tutum_engine_version }}
          imagePullPolicy: {{ k8s_tutum_engine_image_pull_policy }}
          ports:
            - name: http
              containerPort: {{ k8s_tutum_engine_http_port }}
              protocol: TCP
            - name: grpc
              containerPort: {{ k8s_tutum_engine_grpc_port }}
              protocol: TCP
            - name: metrics
              containerPort: {{ k8s_tutum_engine_metrics_port }}
              protocol: TCP
          env:
            - name: LOG_LEVEL
              valueFrom:
                configMapKeyRef:
                  name: tutum-engine-config
                  key: LOG_LEVEL
            - name: ENABLE_METRICS
              valueFrom:
                configMapKeyRef:
                  name: tutum-engine-config
                  key: ENABLE_METRICS
            - name: METRICS_PORT
              valueFrom:
                configMapKeyRef:
                  name: tutum-engine-config
                  key: METRICS_PORT
            - name: POSTGRES_HOST
              valueFrom:
                configMapKeyRef:
                  name: tutum-engine-config
                  key: POSTGRES_HOST
            - name: POSTGRES_PORT
              valueFrom:
                configMapKeyRef:
                  name: tutum-engine-config
                  key: POSTGRES_PORT
            - name: POSTGRES_DB
              valueFrom:
                configMapKeyRef:
                  name: tutum-engine-config
                  key: POSTGRES_DB
            - name: POSTGRES_USER
              valueFrom:
                configMapKeyRef:
                  name: tutum-engine-config
                  key: POSTGRES_USER
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: tutum-engine-secret
                  key: POSTGRES_PASSWORD
            - name: TUTUM_MASTER_KEY
              valueFrom:
                secretKeyRef:
                  name: tutum-engine-secret
                  key: TUTUM_MASTER_KEY
            - name: TUTUM_JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: tutum-engine-secret
                  key: TUTUM_JWT_SECRET
            - name: DATABASE_URL
              value: "postgres://$(POSTGRES_USER):$(POSTGRES_PASSWORD)@$(POSTGRES_HOST):$(POSTGRES_PORT)/$(POSTGRES_DB)?sslmode={{ k8s_tutum_postgres_sslmode }}"
            - name: CREATE_NOT_EXISTING_OBJ
              valueFrom:
                configMapKeyRef:
                  name: tutum-engine-config
                  key: CREATE_NOT_EXISTING_OBJ
            - name: K8S_POD_RESTART_ENABLED
              valueFrom:
                configMapKeyRef:
                  name: tutum-engine-config
                  key: K8S_POD_RESTART_ENABLED
            - name: WEBHOOK_ENABLED
              valueFrom:
                configMapKeyRef:
                  name: tutum-engine-config
                  key: WEBHOOK_ENABLED
            - name: WEBHOOK_ENDPOINTS
              valueFrom:
                configMapKeyRef:
                  name: tutum-engine-config
                  key: WEBHOOK_ENDPOINTS
          startupProbe:
            httpGet:
              path: /health
              port: {{ k8s_tutum_engine_http_port }}
            initialDelaySeconds: 1
            periodSeconds: 2
            timeoutSeconds: 2
            failureThreshold: 30
          livenessProbe:
            httpGet:
              path: /health
              port: {{ k8s_tutum_engine_http_port }}
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /ready
              port: {{ k8s_tutum_engine_http_port }}
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 2
          resources:
            requests:
              cpu: "{{ k8s_tutum_engine_resources.requests.cpu }}"
              memory: "{{ k8s_tutum_engine_resources.requests.memory }}"
            limits:
              cpu: "{{ k8s_tutum_engine_resources.limits.cpu }}"
              memory: "{{ k8s_tutum_engine_resources.limits.memory }}"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
      nodeSelector:
        kubernetes.io/os: linux
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                labelSelector:
                  matchExpressions:
                    - key: app.kubernetes.io/name
                      operator: In
                      values:
                        - tutum-engine
                topologyKey: kubernetes.io/hostname
