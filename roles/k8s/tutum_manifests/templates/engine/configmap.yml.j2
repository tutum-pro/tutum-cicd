---
apiVersion: v1
kind: ConfigMap
metadata:
  name: tutum-engine-config
  namespace: {{ k8s_tutum_namespace }}
  labels:
    app.kubernetes.io/name: tutum-engine
    app.kubernetes.io/component: backend
    app.kubernetes.io/managed-by: ansible
data:
  LOG_LEVEL: "{{ k8s_tutum_log_level }}"
  ENABLE_METRICS: "{{ k8s_tutum_enable_metrics }}"
  METRICS_PORT: "{{ k8s_tutum_engine_metrics_port }}"
{% if k8s_tutum_external_db_url %}
  DATABASE_URL: "{{ k8s_tutum_external_db_url }}"
{% elif k8s_tutum_manifests_db_mode == 'cnpg' %}
  POSTGRES_HOST: "{{ k8s_tutum_cnpg_cluster_name }}-rw.{{ k8s_tutum_cnpg_namespace }}.svc.cluster.local"
  POSTGRES_PORT: "5432"
  POSTGRES_DB: "{{ k8s_tutum_cnpg_db_name }}"
  POSTGRES_USER: "{{ k8s_tutum_cnpg_db_user }}"
  POSTGRES_SSLMODE: "require"
{% elif k8s_tutum_manifests_db_mode == 'external' %}
  POSTGRES_HOST: "{{ k8s_tutum_postgres_host }}"
  POSTGRES_PORT: "{{ k8s_tutum_postgres_port }}"
  POSTGRES_DB: "{{ k8s_tutum_db_name }}"
  POSTGRES_USER: "{{ k8s_tutum_db_user }}"
  POSTGRES_SSLMODE: "{{ k8s_tutum_postgres_sslmode }}"
{% else %}
  POSTGRES_HOST: "tutum-postgres.{{ k8s_tutum_namespace }}.svc.cluster.local"
  POSTGRES_PORT: "5432"
  POSTGRES_DB: "{{ k8s_tutum_db_name }}"
  POSTGRES_USER: "{{ k8s_tutum_db_user }}"
  POSTGRES_SSLMODE: "disable"
{% endif %}
  CREATE_NOT_EXISTING_OBJ: "{{ k8s_tutum_create_not_existing_obj }}"
  K8S_POD_RESTART_ENABLED: "{{ k8s_tutum_pod_restart_enabled }}"
  WEBHOOK_ENABLED: "{{ k8s_tutum_webhook_enabled }}"
  WEBHOOK_ENDPOINTS: "{{ k8s_tutum_webhook_endpoints }}"
{% if k8s_tutum_rest_base_path | default('') | length > 0 %}
  TUTUM_REST_BASE_PATH: "{{ k8s_tutum_rest_base_path }}"
{% endif %}
