# Tutum Platform - Docker Inventory
# Generated by tutum_pro.cicd.docker.tutum_init
#
# This inventory file defines target hosts for Tutum Platform deployment.
# Modify the hosts and connection settings as needed for your environment.

[docker_servers]
{% if docker_tutum_init_ansible_connection == 'local' %}
{{ docker_tutum_init_target_host }} ansible_connection={{ docker_tutum_init_ansible_connection }} ansible_python_interpreter={{ docker_tutum_init_ansible_python_interpreter }}
{% else %}
{% set hostname = docker_tutum_init_target_hostname if docker_tutum_init_target_hostname else docker_tutum_init_target_host | regex_replace('[^a-zA-Z0-9]', '-') %}
{{ hostname }} ansible_host={{ docker_tutum_init_target_host }}
{% endif %}

# To add more hosts, use the following format:
# server2 ansible_host=192.168.1.11

[docker_servers:vars]
{% if docker_tutum_init_ansible_connection != 'local' %}
# SSH connection settings
ansible_connection=ssh
{% if docker_tutum_init_ansible_user %}
ansible_user={{ docker_tutum_init_ansible_user }}
{% endif %}
{% if docker_tutum_init_ansible_ssh_key %}
ansible_ssh_private_key_file={{ docker_tutum_init_ansible_ssh_key }}
{% endif %}
{% if docker_tutum_init_ansible_ssh_pass %}
ansible_ssh_pass={{ docker_tutum_init_ansible_ssh_pass }}
{% endif %}
{% if docker_tutum_init_ansible_become_password %}
ansible_become_password={{ docker_tutum_init_ansible_become_password }}
{% endif %}

{% endif %}
# Become (sudo) settings
ansible_become={{ docker_tutum_init_become | lower }}

# Tutum Engine configuration
docker_tutum_engine_version={{ docker_tutum_engine_version }}
docker_tutum_rest_port={{ docker_tutum_init_rest_port }}
docker_tutum_grpc_port={{ docker_tutum_init_grpc_port }}

# Database configuration
{% if docker_tutum_init_db_mode == 'external' and docker_tutum_init_external_db_url %}
docker_tutum_external_db_url={{ docker_tutum_init_external_db_url }}
{% else %}
docker_tutum_db_name={{ docker_tutum_init_db_name }}
docker_tutum_db_user={{ docker_tutum_init_db_user }}
docker_tutum_db_password={{ docker_tutum_init_db_password }}
docker_tutum_db_port={{ docker_tutum_init_db_port }}
{% endif %}

# Security keys (IMPORTANT: Change these in production!)
# Generate with: openssl rand -base64 32 | head -c 32
{% if docker_tutum_init_master_key %}
docker_tutum_master_key={{ docker_tutum_init_master_key }}
{% else %}
# docker_tutum_master_key=YourSecure32CharacterKeyHere!!!
{% endif %}
{% if docker_tutum_init_jwt_secret %}
docker_tutum_jwt_secret={{ docker_tutum_init_jwt_secret }}
{% else %}
# docker_tutum_jwt_secret=AnotherSecure32CharJwtSecret!!
{% endif %}

# Plugin configuration
docker_tutum_plugin_version={{ docker_tutum_plugin_version }}

# CLI configuration
docker_tutum_cli_version={{ docker_tutum_cli_version }}
