---
apiVersion: v1
kind: Secret
metadata:
  name: tutum-engine-secret
  namespace: {{ k8s_tutum_namespace }}
  labels:
    app.kubernetes.io/name: tutum-engine
    app.kubernetes.io/component: backend
    app.kubernetes.io/managed-by: ansible
type: Opaque
stringData:
{% if k8s_tutum_manifests_db_mode != 'cnpg' %}
  POSTGRES_PASSWORD: "{{ k8s_tutum_db_password }}"
{% else %}
  # For CNPG, password is managed by CNPG operator - reference from cluster secret
  POSTGRES_PASSWORD: "{{ k8s_tutum_cnpg_db_password | default('changeme') }}"
{% endif %}
  TUTUM_MASTER_KEY: "{{ k8s_tutum_master_key }}"
  TUTUM_JWT_SECRET: "{{ k8s_tutum_jwt_secret }}"
