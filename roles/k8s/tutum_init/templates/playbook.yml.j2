---
# Tutum Platform - Kubernetes Installation Playbook
# Generated by tutum_pro.cicd.k8s.tutum_init
#
# Usage:
#   ansible-playbook {{ k8s_tutum_init_playbook_file }}
#
# Requirements:
#   - kubectl configured with cluster access
#   - kubernetes.core collection installed
{% if k8s_tutum_init_db_mode == "external" %}
#   - PostgreSQL database accessible from cluster
{% endif %}

- name: Install Tutum Platform on Kubernetes
  hosts: localhost
  connection: local
  gather_facts: false

  vars:
    # Namespace
    k8s_tutum_namespace: "{{ k8s_tutum_namespace }}"

    # Kubernetes distribution (affects kubelet paths)
    k8s_distribution: "{{ k8s_tutum_init_distribution }}"

{% if k8s_tutum_init_db_mode == "embedded" and k8s_tutum_init_generate_postgres %}
    # Embedded PostgreSQL configuration
    k8s_tutum_db_name: "{{ k8s_tutum_init_postgres_db }}"
    k8s_tutum_db_user: "{{ k8s_tutum_init_postgres_user }}"
    k8s_tutum_db_password: "{{ k8s_tutum_init_postgres_password }}"
{% endif %}

{% if k8s_tutum_init_generate_engine %}
    # Tutum Engine configuration
    k8s_tutum_engine_version: "{{ k8s_tutum_engine_version }}"
{% if k8s_tutum_init_external_db_url %}
    k8s_tutum_external_db_url: "{{ k8s_tutum_init_external_db_url }}"
{% elif k8s_tutum_init_db_mode == "external" and k8s_tutum_init_postgres_host %}
    k8s_tutum_postgres_host: "{{ k8s_tutum_init_postgres_host }}"
    k8s_tutum_postgres_port: "{{ k8s_tutum_init_postgres_port }}"
{% endif %}
    k8s_tutum_db_name: "{{ k8s_tutum_init_postgres_db }}"
    k8s_tutum_db_user: "{{ k8s_tutum_init_postgres_user }}"
    k8s_tutum_db_password: "{{ k8s_tutum_init_postgres_password }}"
{% if k8s_tutum_init_master_key %}
    k8s_tutum_master_key: "{{ k8s_tutum_init_master_key }}"
{% else %}
    # Auto-generate master key (32 characters)
    k8s_tutum_master_key: "{{ '{{' }} lookup('password', '/dev/null chars=ascii_letters,digits length=32') {{ '}}' }}"
{% endif %}
{% if k8s_tutum_init_jwt_secret %}
    k8s_tutum_jwt_secret: "{{ k8s_tutum_init_jwt_secret }}"
{% else %}
    # Auto-generate JWT secret (32 characters)
    k8s_tutum_jwt_secret: "{{ '{{' }} lookup('password', '/dev/null chars=ascii_letters,digits length=32') {{ '}}' }}"
{% endif %}
{% endif %}

{% if k8s_tutum_init_generate_csi %}
    # CSI Driver configuration
    k8s_tutum_csi_version: "{{ k8s_tutum_csi_version }}"
    k8s_tutum_engine_url: "tutum-engine.{{ k8s_tutum_namespace }}.svc.cluster.local:9090"
{% endif %}

  roles:
{% if k8s_tutum_init_db_mode == "embedded" and k8s_tutum_init_generate_postgres %}
    # Embedded PostgreSQL database
    - role: tutum_pro.cicd.k8s.tutum_postgres
{% endif %}

{% if k8s_tutum_init_generate_engine %}
    # Tutum Engine (core service)
    - role: tutum_pro.cicd.k8s.tutum_engine
{% endif %}

{% if k8s_tutum_init_generate_csi %}
    # CSI Driver (certificate volumes)
    - role: tutum_pro.cicd.k8s.tutum_csi
{% endif %}

  post_tasks:
    - name: Display installation summary
      ansible.builtin.debug:
        msg:
          - "=========================================="
          - "  Tutum Platform Installation Complete!"
          - "=========================================="
          - ""
          - "Namespace: {{ k8s_tutum_namespace }}"
{% if k8s_tutum_init_db_mode == "embedded" and k8s_tutum_init_generate_postgres %}
          - ""
          - "PostgreSQL (embedded):"
          - "  - Service: tutum-postgres.{{ k8s_tutum_namespace }}.svc.cluster.local:5432"
          - "  - Database: {{ k8s_tutum_init_postgres_db }}"
{% endif %}
{% if k8s_tutum_init_generate_engine %}
          - ""
          - "Tutum Engine:"
          - "  - REST API: http://tutum-engine.{{ k8s_tutum_namespace }}.svc.cluster.local:8080"
          - "  - gRPC API: tutum-engine.{{ k8s_tutum_namespace }}.svc.cluster.local:9090"
{% endif %}
{% if k8s_tutum_init_generate_csi %}
          - ""
          - "CSI Driver:"
          - "  - StorageClass: tutum-csi"
          - "  - Driver: csi.tutum.io"
{% endif %}
          - ""
          - "IMPORTANT: Save your security keys!"
