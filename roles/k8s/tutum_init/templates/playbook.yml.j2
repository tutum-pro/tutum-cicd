---
# Tutum Platform - Kubernetes Installation Playbook
# Generated by tutum_pro.cicd.k8s.tutum_init
#
# Usage:
#   ansible-playbook -i {{ k8s_tutum_init_inventory_path }}/{{ k8s_tutum_init_inventory_file }} {{ k8s_tutum_init_playbook_file }}
#
# Requirements:
#   - kubectl configured with cluster access
#   - kubernetes.core collection installed
{% if k8s_tutum_init_db_mode == "external" %}
#   - PostgreSQL database accessible from cluster
{% endif %}

- name: Install Tutum Platform on Kubernetes
  hosts: k8s_controllers
  gather_facts: true

  # All variables are defined in inventory file (k8s_controllers:vars section)
  # This allows easy customization without modifying the playbook

  pre_tasks:
{% if k8s_tutum_init_db_mode == "embedded" %}
    # For embedded PostgreSQL, set connection details
    - name: Set PostgreSQL host for embedded mode
      ansible.builtin.set_fact:
        k8s_tutum_postgres_host: "tutum-postgres.{{ '{{' }} k8s_tutum_namespace {{ '}}' }}.svc.cluster.local"
        k8s_tutum_postgres_port: "5432"
      when: k8s_tutum_postgres_host is not defined or k8s_tutum_postgres_host == ""

{% elif k8s_tutum_init_db_mode == "cnpg" %}
    # For CNPG, set connection details (credentials are managed by CNPG secrets)
    - name: Set PostgreSQL host for CNPG mode
      ansible.builtin.set_fact:
        k8s_tutum_postgres_host: "{{ '{{' }} k8s_tutum_cnpg_cluster_name | default('tutum-postgres') {{ '}}' }}-rw.{{ '{{' }} k8s_tutum_namespace {{ '}}' }}.svc.cluster.local"
        k8s_tutum_postgres_port: "5432"
        k8s_tutum_db_name: "{{ '{{' }} k8s_tutum_cnpg_db_name | default('tutum') {{ '}}' }}"
        k8s_tutum_db_user: "{{ '{{' }} k8s_tutum_cnpg_db_user | default('tutum') {{ '}}' }}"
        k8s_tutum_db_password: "{{ '{{' }} k8s_tutum_cnpg_db_password | default('') {{ '}}' }}"
      when: k8s_tutum_postgres_host is not defined or k8s_tutum_postgres_host == ""

{% endif %}
    # Auto-generate security keys if not provided
    - name: Generate master key if not set
      ansible.builtin.set_fact:
        k8s_tutum_master_key: "{{ '{{' }} lookup('password', '/dev/null chars=ascii_letters,digits length=32') {{ '}}' }}"
      when: k8s_tutum_master_key is not defined or k8s_tutum_master_key == ""

    - name: Generate JWT secret if not set
      ansible.builtin.set_fact:
        k8s_tutum_jwt_secret: "{{ '{{' }} lookup('password', '/dev/null chars=ascii_letters,digits length=32') {{ '}}' }}"
      when: k8s_tutum_jwt_secret is not defined or k8s_tutum_jwt_secret == ""

  roles:
{% if k8s_tutum_init_db_mode == "embedded" and k8s_tutum_init_generate_postgres %}
    # Embedded PostgreSQL database (simple deployment)
    - role: tutum_pro.cicd.k8s.tutum_postgres
{% elif k8s_tutum_init_db_mode == "cnpg" and k8s_tutum_init_generate_postgres %}
    # CloudNativePG PostgreSQL cluster (production-ready)
    - role: tutum_pro.cicd.k8s.tutum_cnpg
{% endif %}

{% if k8s_tutum_init_generate_engine %}
    # Tutum Engine (core service)
    - role: tutum_pro.cicd.k8s.tutum_engine
{% endif %}

{% if k8s_tutum_init_generate_csi %}
    # CSI Driver (certificate volumes)
    - role: tutum_pro.cicd.k8s.tutum_csi
{% endif %}

  post_tasks:
    - name: Display installation summary
      ansible.builtin.debug:
        msg:
          - "=========================================="
          - "  Tutum Platform Installation Complete!"
          - "=========================================="
          - ""
          - "Namespace: {{ '{{' }} k8s_tutum_namespace {{ '}}' }}"
{% if k8s_tutum_init_db_mode == "embedded" and k8s_tutum_init_generate_postgres %}
          - ""
          - "PostgreSQL (embedded):"
          - "  - Service: tutum-postgres.{{ '{{' }} k8s_tutum_namespace {{ '}}' }}.svc.cluster.local:5432"
          - "  - Database: {{ '{{' }} k8s_tutum_db_name {{ '}}' }}"
{% elif k8s_tutum_init_db_mode == "cnpg" and k8s_tutum_init_generate_postgres %}
          - ""
          - "PostgreSQL (CloudNativePG):"
          - "  - Cluster: {{ '{{' }} k8s_tutum_cnpg_cluster_name | default('tutum-postgres') {{ '}}' }}"
          - "  - RW Service: {{ '{{' }} k8s_tutum_cnpg_cluster_name | default('tutum-postgres') {{ '}}' }}-rw.{{ '{{' }} k8s_tutum_namespace {{ '}}' }}.svc.cluster.local:5432"
          - "  - Database: {{ '{{' }} k8s_tutum_cnpg_db_name {{ '}}' }}"
          - "  - Instances: {{ '{{' }} k8s_tutum_cnpg_instances {{ '}}' }}"
{% endif %}
{% if k8s_tutum_init_generate_engine %}
          - ""
          - "Tutum Engine:"
          - "  - REST API: http://tutum-engine.{{ '{{' }} k8s_tutum_namespace {{ '}}' }}.svc.cluster.local:8080"
          - "  - gRPC API: tutum-engine.{{ '{{' }} k8s_tutum_namespace {{ '}}' }}.svc.cluster.local:9090"
{% endif %}
{% if k8s_tutum_init_generate_csi %}
          - ""
          - "CSI Driver:"
          - "  - StorageClass: tutum-csi"
          - "  - Driver: csi.tutum.io"
{% endif %}
          - ""
          - "IMPORTANT: Save your security keys!"
          - "  - TUTUM_MASTER_KEY: {{ '{{' }} k8s_tutum_master_key {{ '}}' }}"
          - "  - TUTUM_JWT_SECRET: {{ '{{' }} k8s_tutum_jwt_secret {{ '}}' }}"
