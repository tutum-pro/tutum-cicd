---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: tutum-operator
  namespace: {{ k8s_tutum_namespace }}
  labels:
    app.kubernetes.io/name: tutum-operator
    app.kubernetes.io/version: "{{ k8s_tutum_operator_version }}"
    app.kubernetes.io/managed-by: ansible
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: tutum-operator-role
  labels:
    app.kubernetes.io/name: tutum-operator
    app.kubernetes.io/version: "{{ k8s_tutum_operator_version }}"
    app.kubernetes.io/managed-by: ansible
rules:
  - apiGroups:
      - tutum.io
    resources:
      - tutumcertificates
    verbs:
      - get
      - list
      - watch
      - update
      - patch
  - apiGroups:
      - tutum.io
    resources:
      - tutumcertificates/status
    verbs:
      - get
      - update
      - patch
  - apiGroups:
      - tutum.io
    resources:
      - tutumcertificates/finalizers
    verbs:
      - update
  - apiGroups:
      - ""
    resources:
      - secrets
    verbs:
      - get
      - list
      - watch
      - create
      - update
      - patch
      - delete
  - apiGroups:
      - ""
    resources:
      - events
    verbs:
      - create
      - patch
  - apiGroups:
      - coordination.k8s.io
    resources:
      - leases
    verbs:
      - get
      - list
      - watch
      - create
      - update
      - patch
      - delete
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: tutum-operator-binding
  labels:
    app.kubernetes.io/name: tutum-operator
    app.kubernetes.io/version: "{{ k8s_tutum_operator_version }}"
    app.kubernetes.io/managed-by: ansible
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: tutum-operator-role
subjects:
  - kind: ServiceAccount
    name: tutum-operator
    namespace: {{ k8s_tutum_namespace }}
