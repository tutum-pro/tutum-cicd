---
apiVersion: v1
kind: Service
metadata:
  name: tutum-postgres
  namespace: {{ k8s_tutum_namespace }}
  labels:
    app.kubernetes.io/name: tutum-postgres
    app.kubernetes.io/component: database
    app.kubernetes.io/part-of: tutum
spec:
  type: {{ k8s_tutum_postgres_service_type }}
  ports:
    - port: {{ k8s_tutum_db_port | int }}
      targetPort: 5432
      protocol: TCP
      name: postgres
  selector:
    app.kubernetes.io/name: tutum-postgres
