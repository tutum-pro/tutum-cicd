---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tutum-postgres
  namespace: {{ k8s_tutum_namespace }}
  labels:
    app.kubernetes.io/name: tutum-postgres
    app.kubernetes.io/component: database
    app.kubernetes.io/part-of: tutum
spec:
  replicas: {{ k8s_tutum_postgres_replicas }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: tutum-postgres
  template:
    metadata:
      labels:
        app.kubernetes.io/name: tutum-postgres
        app.kubernetes.io/component: database
        app.kubernetes.io/part-of: tutum
    spec:
{% if k8s_tutum_registry_url | default('') | length > 0 %}
      imagePullSecrets:
        - name: {{ k8s_tutum_registry_secret_name }}
{% endif %}
      containers:
        - name: postgres
          image: {{ k8s_tutum_postgres_image }}:{{ k8s_tutum_postgres_version }}
          imagePullPolicy: {{ k8s_tutum_postgres_image_pull_policy }}
          ports:
            - containerPort: 5432
              name: postgres
              protocol: TCP
          envFrom:
            - secretRef:
                name: tutum-postgres-secret
          resources:
            requests:
              cpu: {{ k8s_tutum_postgres_resources.requests.cpu }}
              memory: {{ k8s_tutum_postgres_resources.requests.memory }}
            limits:
              cpu: {{ k8s_tutum_postgres_resources.limits.cpu }}
              memory: {{ k8s_tutum_postgres_resources.limits.memory }}
          volumeMounts:
            - name: postgres-data
{% if k8s_tutum_postgres_image_type == 'openshift' %}
              mountPath: /var/lib/pgsql/data
{% else %}
              mountPath: /var/lib/postgresql/data
              subPath: pgdata
{% endif %}
          livenessProbe:
            exec:
              command:
                - pg_isready
                - -U
                - {{ k8s_tutum_db_user }}
                - -d
                - {{ k8s_tutum_db_name }}
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 6
          readinessProbe:
            exec:
              command:
                - pg_isready
                - -U
                - {{ k8s_tutum_db_user }}
                - -d
                - {{ k8s_tutum_db_name }}
{% if k8s_tutum_postgres_image_type == 'openshift' %}
            initialDelaySeconds: 15
{% else %}
            initialDelaySeconds: 5
{% endif %}
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 3
      volumes:
        - name: postgres-data
          persistentVolumeClaim:
            claimName: tutum-postgres-data
