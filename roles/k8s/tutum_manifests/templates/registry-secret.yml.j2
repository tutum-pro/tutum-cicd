{% if k8s_tutum_registry_url | default('') | length > 0 %}
---
# Image Pull Secret for Private Registry
# This secret is used by all deployments to pull images from private registry
apiVersion: v1
kind: Secret
metadata:
  name: {{ k8s_tutum_registry_secret_name }}
  namespace: {{ k8s_tutum_namespace }}
  labels:
    app.kubernetes.io/name: tutum-system
    app.kubernetes.io/component: registry-secret
    app.kubernetes.io/managed-by: ansible
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: {{ lookup('template', 'dockerconfigjson.j2') | b64encode }}
{% endif %}
