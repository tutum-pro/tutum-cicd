# Tutum Platform - Sample Inventory for Air-Gapped Installation
# Generated by tutum_offline_bundle role
#
# Copy this file and adjust for your environment.
# Usage: ansible-playbook playbooks/install-tutum-k8s.yml -i this-file.ini

[all:vars]
# ==================== Kubernetes Distribution ====================
k8s_distribution={{ k8s_distribution | default('kubernetes') }}

# ==================== Namespace ====================
k8s_tutum_namespace=tutum

# ==================== Database Mode ====================
# Options: embedded, cnpg, external
k8s_tutum_db_mode={{ k8s_tutum_offline_db_mode }}

{% if k8s_tutum_offline_db_mode == 'external' %}
# External database connection
k8s_tutum_postgres_host=your-postgres-host.example.com
k8s_tutum_postgres_port=5432
k8s_tutum_db_name=tutum
k8s_tutum_db_user=tutum
k8s_tutum_db_password=CHANGE_ME
{% endif %}

# ==================== Certificate Injection Mode ====================
# Options: csi, operator
k8s_tutum_injection_mode={{ k8s_tutum_offline_injection_mode }}

# ==================== Image Registry ====================
{% if k8s_tutum_offline_internal_registry | length > 0 %}
# Internal registry (pre-configured for this bundle)
k8s_tutum_image_registry={{ k8s_tutum_offline_internal_registry }}/{{ k8s_tutum_offline_internal_prefix }}
{% else %}
# Uncomment and configure for internal registry:
# k8s_tutum_image_registry=registry.example.com/tutum
{% endif %}

# ==================== Component Versions ====================
k8s_tutum_engine_version={{ k8s_tutum_engine_version }}
{% if k8s_tutum_offline_db_mode == 'embedded' %}
k8s_tutum_postgres_version={{ k8s_tutum_postgres_version }}
{% elif k8s_tutum_offline_db_mode == 'cnpg' %}
k8s_tutum_cnpg_operator_version={{ k8s_tutum_cnpg_operator_version }}
k8s_tutum_cnpg_postgres_version={{ k8s_tutum_cnpg_postgres_version }}
{% endif %}
{% if k8s_tutum_offline_injection_mode == 'csi' %}
k8s_tutum_csi_version={{ k8s_tutum_csi_version }}
{% elif k8s_tutum_offline_injection_mode == 'operator' %}
k8s_tutum_operator_version={{ k8s_tutum_operator_version }}
{% endif %}

# ==================== Ingress Configuration ====================
# Uncomment to enable ingress
# k8s_tutum_engine_ingress_enabled=true
# k8s_tutum_engine_ingress_host=tutum.example.com
# k8s_tutum_engine_ingress_class_name=nginx
# k8s_tutum_engine_ingress_tls_enabled=true
# k8s_tutum_engine_ingress_tls_secret_name=tutum-tls

{% if k8s_distribution == 'openshift' %}
# ==================== OpenShift Route ====================
# k8s_tutum_engine_route_enabled=true
# k8s_tutum_engine_route_host=tutum.apps.example.com
# k8s_tutum_engine_route_termination=edge
{% endif %}

# ==================== REST API Configuration ====================
# k8s_tutum_rest_base_path=/api
# k8s_tutum_engine_http_port=8080
# k8s_tutum_engine_grpc_port=9090
