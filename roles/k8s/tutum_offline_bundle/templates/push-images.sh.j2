#!/bin/bash
# Tutum Platform - Push Images to Internal Registry
# Generated by tutum_offline_bundle role
#
# This script pushes all loaded Docker images to an internal registry.
# Run this script after loading images with load-images.sh

set -e

INTERNAL_REGISTRY="{{ k8s_tutum_offline_internal_registry }}"
INTERNAL_PREFIX="{{ k8s_tutum_offline_internal_prefix }}"

echo "==========================================="
echo "  Tutum Platform - Push to Internal Registry"
echo "==========================================="
echo ""
echo "Target registry: ${INTERNAL_REGISTRY}"
echo "Image prefix: ${INTERNAL_PREFIX}"
echo ""

if ! command -v docker &> /dev/null; then
    echo "ERROR: Docker is not installed or not in PATH"
    exit 1
fi

# Check if we can connect to the registry
echo "Testing connection to registry..."
if ! docker login "${INTERNAL_REGISTRY}" 2>/dev/null; then
    echo "WARNING: Could not authenticate to registry."
    echo "You may need to run 'docker login ${INTERNAL_REGISTRY}' first."
    read -p "Continue anyway? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

echo ""
echo "Pushing images..."
echo ""

{% for image in _required_images %}
# {{ image.component }}
ORIGINAL_IMAGE="{{ image.name }}:{{ image.tag }}"
INTERNAL_IMAGE="${INTERNAL_REGISTRY}/${INTERNAL_PREFIX}/{{ image.name | basename }}:{{ image.tag }}"

echo "Pushing {{ image.component }}..."
echo "  From: ${ORIGINAL_IMAGE}"
echo "  To:   ${INTERNAL_IMAGE}"

# Tag if not already tagged
if ! docker images --format "{{ '{{' }}.Repository}}:{{ '{{' }}.Tag}}" | grep -q "^${INTERNAL_IMAGE}$"; then
    docker tag "${ORIGINAL_IMAGE}" "${INTERNAL_IMAGE}"
fi

docker push "${INTERNAL_IMAGE}"
echo ""

{% endfor %}

echo "==========================================="
echo "  All images pushed successfully!"
echo "==========================================="
echo ""
echo "Images are now available at:"
{% for image in _required_images %}
echo "  - ${INTERNAL_REGISTRY}/${INTERNAL_PREFIX}/{{ image.name | basename }}:{{ image.tag }}"
{% endfor %}
echo ""
echo "Update your inventory with:"
echo "  k8s_tutum_image_registry=${INTERNAL_REGISTRY}/${INTERNAL_PREFIX}"
