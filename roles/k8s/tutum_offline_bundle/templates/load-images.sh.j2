#!/bin/bash
# Tutum Platform - Load Docker Images
# Generated by tutum_offline_bundle role
#
# This script loads all Docker images from tar files into the local Docker daemon.
# Run this script on the air-gapped system after extracting the bundle.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGES_DIR="${SCRIPT_DIR}/../images"

echo "==========================================="
echo "  Tutum Platform - Load Docker Images"
echo "==========================================="
echo ""

if ! command -v docker &> /dev/null; then
    echo "ERROR: Docker is not installed or not in PATH"
    exit 1
fi

echo "Loading images from: ${IMAGES_DIR}"
echo ""

# Load original images
{% for image in _required_images %}
echo "Loading {{ image.component }}..."
docker load -i "${IMAGES_DIR}/{{ image.component }}.tar"
{% endfor %}

{% if k8s_tutum_offline_internal_registry | length > 0 and k8s_tutum_offline_save_retagged | bool %}
# Load retagged images (for internal registry)
echo ""
echo "Loading retagged images for internal registry..."
{% for image in _required_images %}
if [ -f "${IMAGES_DIR}/{{ image.component }}-internal.tar" ]; then
    echo "Loading {{ image.component }}-internal..."
    docker load -i "${IMAGES_DIR}/{{ image.component }}-internal.tar"
fi
{% endfor %}
{% endif %}

echo ""
echo "==========================================="
echo "  All images loaded successfully!"
echo "==========================================="
echo ""
echo "Loaded images:"
docker images | grep -E "(tutum|cnpg|csi)" | head -20 || true
