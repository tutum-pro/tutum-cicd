# Tutum Platform - Kubernetes Inventory
# Generated by tutum_pro.cicd.k8s.tutum_init
#
# This inventory file defines configuration for Tutum Platform deployment on Kubernetes.
# Modify the variables as needed for your environment.
#
# Usage:
#   ansible-playbook -i {{ k8s_tutum_init_inventory_path }}/{{ k8s_tutum_init_inventory_file }} {{ k8s_tutum_init_playbook_file }}

[k8s_controllers]
localhost ansible_connection=local ansible_python_interpreter={{ k8s_tutum_init_ansible_python_interpreter | default('/usr/bin/python3') }}

# To deploy from a remote host, use:
# k8s-controller ansible_host=192.168.1.100 ansible_user=admin ansible_connection=ssh

[k8s_controllers:vars]
# =============================================================================
# Kubernetes Configuration
# =============================================================================

# Namespace for Tutum Platform components
k8s_tutum_namespace={{ k8s_tutum_namespace }}

# Kubernetes distribution (affects kubelet paths for CSI driver)
# Options: standard, microk8s, k3s, rke2, openshift
k8s_distribution={{ k8s_tutum_init_distribution }}

# =============================================================================
# Component Versions
# =============================================================================

k8s_tutum_engine_version={{ k8s_tutum_engine_version }}
k8s_tutum_csi_version={{ k8s_tutum_csi_version }}
{% if k8s_tutum_init_db_mode == "embedded" %}
k8s_tutum_postgres_version={{ k8s_tutum_postgres_version | default('15-alpine') }}
{% endif %}

# =============================================================================
# Database Configuration
# =============================================================================

# Database mode: embedded, cnpg, or external
k8s_tutum_init_db_mode={{ k8s_tutum_init_db_mode }}

{% if k8s_tutum_init_db_mode == "cnpg" %}
# CloudNativePG Configuration
k8s_tutum_cnpg_namespace={{ k8s_tutum_cnpg_namespace | default('pgdb') }}
k8s_tutum_cnpg_operator_version={{ k8s_tutum_cnpg_operator_version }}
k8s_tutum_cnpg_postgres_version={{ k8s_tutum_cnpg_postgres_version }}
k8s_tutum_cnpg_instances={{ k8s_tutum_cnpg_instances }}
k8s_tutum_cnpg_storage_size={{ k8s_tutum_cnpg_storage_size }}
k8s_tutum_cnpg_enable_pooler={{ k8s_tutum_cnpg_enable_pooler | lower }}
k8s_tutum_cnpg_cluster_name=tutum-postgres
k8s_tutum_cnpg_db_name={{ k8s_tutum_init_postgres_db }}
k8s_tutum_cnpg_db_user={{ k8s_tutum_init_postgres_user }}
{% if k8s_tutum_init_postgres_password and k8s_tutum_init_postgres_password != 'tutum' %}
k8s_tutum_cnpg_db_password={{ k8s_tutum_init_postgres_password }}
{% else %}
# k8s_tutum_cnpg_db_password=  # Leave empty to auto-generate
{% endif %}

{% elif k8s_tutum_init_external_db_url %}
# External database URL (takes precedence over individual settings)
k8s_tutum_external_db_url={{ k8s_tutum_init_external_db_url }}

{% elif k8s_tutum_init_db_mode == "external" and k8s_tutum_init_postgres_host %}
# External PostgreSQL connection
k8s_tutum_postgres_host={{ k8s_tutum_init_postgres_host }}
k8s_tutum_postgres_port={{ k8s_tutum_init_postgres_port }}
k8s_tutum_postgres_sslmode={{ k8s_tutum_init_postgres_sslmode | default('disable') }}

{% elif k8s_tutum_init_db_mode == "embedded" %}
# Embedded PostgreSQL (simple deployment in Kubernetes)
# k8s_tutum_postgres_host is set automatically to tutum-postgres.{{ k8s_tutum_namespace }}.svc.cluster.local
{% endif %}

# Database credentials (for embedded/external modes)
{% if k8s_tutum_init_db_mode != "cnpg" %}
k8s_tutum_db_name={{ k8s_tutum_init_postgres_db }}
k8s_tutum_db_user={{ k8s_tutum_init_postgres_user }}
k8s_tutum_db_password={{ k8s_tutum_init_postgres_password }}
{% endif %}

# =============================================================================
# Security Keys (IMPORTANT: Change these in production!)
# =============================================================================
# Keys must be exactly 32 characters for AES-256 encryption
# Generate with: openssl rand -base64 32 | head -c 32

{% if k8s_tutum_init_master_key %}
k8s_tutum_master_key={{ k8s_tutum_init_master_key }}
{% else %}
# k8s_tutum_master_key=YourSecure32CharacterKeyHere!!!
{% endif %}
{% if k8s_tutum_init_jwt_secret %}
k8s_tutum_jwt_secret={{ k8s_tutum_init_jwt_secret }}
{% else %}
# k8s_tutum_jwt_secret=AnotherSecure32CharJwtSecret!!
{% endif %}

# =============================================================================
# CSI Driver Configuration
# =============================================================================

k8s_tutum_engine_url=tutum-engine.{{ k8s_tutum_namespace }}.svc.cluster.local:9090

# =============================================================================
# Ingress Configuration (optional)
# =============================================================================

k8s_tutum_engine_ingress_enabled={{ k8s_tutum_init_ingress_enabled | lower }}
{% if k8s_tutum_init_ingress_enabled %}
k8s_tutum_engine_ingress_class_name={{ k8s_tutum_init_ingress_class_name }}
{% if k8s_tutum_init_ingress_host %}
k8s_tutum_engine_ingress_host={{ k8s_tutum_init_ingress_host }}
{% endif %}
k8s_tutum_engine_ingress_path={{ k8s_tutum_init_ingress_path }}
k8s_tutum_engine_ingress_tls_enabled={{ k8s_tutum_init_ingress_tls_enabled | lower }}
{% if k8s_tutum_init_ingress_tls_secret_name %}
k8s_tutum_engine_ingress_tls_secret_name={{ k8s_tutum_init_ingress_tls_secret_name }}
{% endif %}
{% if k8s_tutum_init_ingress_cert_manager_issuer %}
# Ingress annotations for cert-manager
# k8s_tutum_engine_ingress_annotations={"cert-manager.io/cluster-issuer": "{{ k8s_tutum_init_ingress_cert_manager_issuer }}"}
{% endif %}
{% else %}
# k8s_tutum_engine_ingress_class_name=nginx
# k8s_tutum_engine_ingress_host=tutum.example.com
# k8s_tutum_engine_ingress_path=/api
# k8s_tutum_engine_ingress_tls_enabled=true
# k8s_tutum_engine_ingress_tls_secret_name=tutum-tls
{% endif %}
