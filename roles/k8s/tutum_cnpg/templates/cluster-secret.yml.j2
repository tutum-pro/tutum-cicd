---
# Secret for application user credentials
apiVersion: v1
kind: Secret
metadata:
  name: {{ k8s_tutum_cnpg_cluster_name }}-app-credentials
  namespace: {{ k8s_tutum_cnpg_namespace }}
  labels:
    app.kubernetes.io/name: tutum
    app.kubernetes.io/component: database
    cnpg.io/cluster: {{ k8s_tutum_cnpg_cluster_name }}
type: kubernetes.io/basic-auth
stringData:
  username: {{ k8s_tutum_cnpg_db_user }}
  password: {{ _cnpg_app_password | trim }}
---
# Secret for superuser credentials
apiVersion: v1
kind: Secret
metadata:
  name: {{ k8s_tutum_cnpg_cluster_name }}-superuser-credentials
  namespace: {{ k8s_tutum_cnpg_namespace }}
  labels:
    app.kubernetes.io/name: tutum
    app.kubernetes.io/component: database
    cnpg.io/cluster: {{ k8s_tutum_cnpg_cluster_name }}
type: kubernetes.io/basic-auth
stringData:
  username: postgres
  password: {{ _cnpg_superuser_password | trim }}
