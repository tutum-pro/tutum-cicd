# Tutum Platform - Images Manifest
# Generated by tutum_offline_bundle role
#
# This file contains the list of all Docker images included in this bundle.
# Use this for verification and documentation purposes.

bundle_info:
  generated_at: "{{ ansible_date_time.iso8601 }}"
  db_mode: "{{ k8s_tutum_offline_db_mode }}"
  injection_mode: "{{ k8s_tutum_offline_injection_mode }}"
{% if k8s_tutum_offline_internal_registry | length > 0 %}
  internal_registry: "{{ k8s_tutum_offline_internal_registry }}"
  internal_prefix: "{{ k8s_tutum_offline_internal_prefix }}"
{% endif %}

images:
{% for image in _required_images %}
  - component: "{{ image.component }}"
    original:
      name: "{{ image.name }}"
      tag: "{{ image.tag }}"
      full: "{{ image.name }}:{{ image.tag }}"
    tar_file: "{{ image.component }}.tar"
{% if k8s_tutum_offline_internal_registry | length > 0 %}
    internal:
      name: "{{ k8s_tutum_offline_internal_registry }}/{{ k8s_tutum_offline_internal_prefix }}/{{ image.name | basename }}"
      tag: "{{ image.tag }}"
      full: "{{ k8s_tutum_offline_internal_registry }}/{{ k8s_tutum_offline_internal_prefix }}/{{ image.name | basename }}:{{ image.tag }}"
{% if k8s_tutum_offline_save_retagged | bool %}
    internal_tar_file: "{{ image.component }}-internal.tar"
{% endif %}
{% endif %}
{% endfor %}

collection:
  name: "{{ k8s_tutum_offline_collection_name }}"
{% if k8s_tutum_offline_collection_version %}
  version: "{{ k8s_tutum_offline_collection_version }}"
{% else %}
  version: "latest"
{% endif %}
  source: "{{ k8s_tutum_offline_collection_source }}"

versions:
  tutum_engine: "{{ k8s_tutum_engine_version }}"
{% if k8s_tutum_offline_db_mode == 'embedded' %}
  postgres: "{{ k8s_tutum_postgres_version }}"
{% elif k8s_tutum_offline_db_mode == 'cnpg' %}
  cnpg_operator: "{{ k8s_tutum_cnpg_operator_version }}"
  cnpg_postgres: "{{ k8s_tutum_cnpg_postgres_version }}"
{% endif %}
{% if k8s_tutum_offline_injection_mode == 'csi' %}
  csi_driver: "{{ k8s_tutum_csi_version }}"
  csi_provisioner: "{{ k8s_csi_provisioner_version }}"
  csi_node_driver_registrar: "{{ k8s_csi_node_driver_registrar_version }}"
{% elif k8s_tutum_offline_injection_mode == 'operator' %}
  operator: "{{ k8s_tutum_operator_version }}"
{% endif %}
