# Tutum Platform - Sample Inventory for Air-Gapped Installation
# Generated by tutum_offline_bundle role
#
# Copy this file and adjust for your environment.
# Usage: ansible-playbook playbooks/install-tutum-k8s.yml -i this-file.ini

[all:vars]
# ==================== Kubernetes Distribution ====================
k8s_distribution={{ k8s_distribution | default('kubernetes') }}

# ==================== Namespace ====================
k8s_tutum_namespace=tutum-system

# ==================== Database Mode ====================
# Options: embedded, cnpg, external
k8s_tutum_init_db_mode={{ k8s_tutum_offline_db_mode }}

{% if k8s_tutum_offline_db_mode == 'external' %}
# External database connection
k8s_tutum_postgres_host=your-postgres-host.example.com
k8s_tutum_postgres_port=5432
k8s_tutum_db_name=tutum
k8s_tutum_db_user=tutum
k8s_tutum_db_password=CHANGE_ME
{% endif %}

# ==================== Certificate Injection Mode ====================
# Options: csi, operator
k8s_tutum_init_injection_mode={{ k8s_tutum_offline_injection_mode }}

# ==================== Component Versions ====================
k8s_tutum_engine_version={{ k8s_tutum_engine_version }}
{% if k8s_tutum_offline_db_mode == 'embedded' %}
k8s_tutum_postgres_version={{ k8s_tutum_postgres_version }}
{% elif k8s_tutum_offline_db_mode == 'cnpg' %}
k8s_tutum_cnpg_operator_version={{ k8s_tutum_cnpg_operator_version }}
k8s_tutum_cnpg_postgres_version={{ k8s_tutum_cnpg_postgres_version }}
{% endif %}
{% if k8s_tutum_offline_injection_mode == 'csi' %}
k8s_tutum_csi_version={{ k8s_tutum_csi_version }}
k8s_csi_provisioner_version={{ k8s_csi_provisioner_version }}
k8s_csi_node_driver_registrar_version={{ k8s_csi_node_driver_registrar_version }}
{% elif k8s_tutum_offline_injection_mode == 'operator' %}
k8s_tutum_operator_version={{ k8s_tutum_operator_version }}
{% endif %}

# ==================== Image Configuration ====================
{% if k8s_tutum_offline_internal_registry | length > 0 %}
{% set _registry_prefix = k8s_tutum_offline_internal_registry ~ '/' ~ k8s_tutum_offline_internal_prefix %}
# Internal registry images (pre-configured for this bundle)
# After running push-images.sh, these images will be available at:

# Tutum Engine
k8s_tutum_engine_image={{ _registry_prefix }}/tutum-engine

{% if k8s_tutum_offline_db_mode == 'embedded' %}
# PostgreSQL (embedded mode)
k8s_tutum_postgres_image={{ _registry_prefix }}/postgres
{% elif k8s_tutum_offline_db_mode == 'cnpg' %}
# CloudNativePG (CNPG mode)
k8s_tutum_cnpg_operator_image={{ _registry_prefix }}/cloudnative-pg
k8s_tutum_cnpg_image={{ _registry_prefix }}/postgresql:{{ k8s_tutum_cnpg_postgres_version }}
{% endif %}

{% if k8s_tutum_offline_injection_mode == 'csi' %}
# CSI Driver
k8s_tutum_csi_image={{ _registry_prefix }}/tutum-csi-driver-k8s
k8s_csi_provisioner_image={{ _registry_prefix }}/csi-provisioner
k8s_csi_node_driver_registrar_image={{ _registry_prefix }}/csi-node-driver-registrar
{% elif k8s_tutum_offline_injection_mode == 'operator' %}
# Tutum Operator
k8s_tutum_operator_image={{ _registry_prefix }}/tutum-operator-k8s
{% endif %}

{% else %}
# ==================== Default Image Sources ====================
# Uncomment and modify for internal registry usage:
#
# k8s_tutum_engine_image=your-registry.local/tutum/tutum-engine
{% if k8s_tutum_offline_db_mode == 'embedded' %}
# k8s_tutum_postgres_image=your-registry.local/tutum/postgres
{% elif k8s_tutum_offline_db_mode == 'cnpg' %}
# k8s_tutum_cnpg_operator_image=your-registry.local/tutum/cloudnative-pg
# k8s_tutum_cnpg_image=your-registry.local/tutum/postgresql:{{ k8s_tutum_cnpg_postgres_version }}
{% endif %}
{% if k8s_tutum_offline_injection_mode == 'csi' %}
# k8s_tutum_csi_image=your-registry.local/tutum/tutum-csi-driver-k8s
# k8s_csi_provisioner_image=your-registry.local/tutum/csi-provisioner
# k8s_csi_node_driver_registrar_image=your-registry.local/tutum/csi-node-driver-registrar
{% elif k8s_tutum_offline_injection_mode == 'operator' %}
# k8s_tutum_operator_image=your-registry.local/tutum/tutum-operator-k8s
{% endif %}
{% endif %}

# ==================== Ingress Configuration ====================
# Uncomment to enable ingress
# k8s_tutum_engine_ingress_enabled=true
# k8s_tutum_engine_ingress_host=tutum.example.com
# k8s_tutum_engine_ingress_class_name=nginx
# k8s_tutum_engine_ingress_tls_enabled=true
# k8s_tutum_engine_ingress_tls_secret_name=tutum-tls

{% if k8s_distribution == 'openshift' %}
# ==================== OpenShift Route ====================
# k8s_tutum_engine_route_enabled=true
# k8s_tutum_engine_route_host=tutum.apps.example.com
# k8s_tutum_engine_route_termination=edge
{% endif %}

# ==================== REST API Configuration ====================
# k8s_tutum_rest_base_path=/api
# k8s_tutum_engine_http_port=8080
# k8s_tutum_engine_grpc_port=9090

# ==================== Security (change these!) ====================
# k8s_tutum_master_key=  # Leave empty to auto-generate
# k8s_tutum_jwt_secret=  # Leave empty to auto-generate
