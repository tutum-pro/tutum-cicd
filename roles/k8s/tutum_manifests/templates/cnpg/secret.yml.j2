---
# Application user credentials
apiVersion: v1
kind: Secret
metadata:
  name: {{ k8s_tutum_cnpg_cluster_name }}-app-credentials
  namespace: {{ k8s_tutum_cnpg_namespace }}
  labels:
    app.kubernetes.io/name: tutum
    app.kubernetes.io/component: database
type: kubernetes.io/basic-auth
stringData:
  username: "{{ k8s_tutum_cnpg_db_user }}"
{% if k8s_tutum_cnpg_db_password %}
  password: "{{ k8s_tutum_cnpg_db_password }}"
{% else %}
  # Auto-generated password
  password: "{{ lookup('password', '/dev/null chars=ascii_letters,digits length=24') }}"
{% endif %}
---
# Superuser credentials
apiVersion: v1
kind: Secret
metadata:
  name: {{ k8s_tutum_cnpg_cluster_name }}-superuser-credentials
  namespace: {{ k8s_tutum_cnpg_namespace }}
  labels:
    app.kubernetes.io/name: tutum
    app.kubernetes.io/component: database
type: kubernetes.io/basic-auth
stringData:
  username: "postgres"
{% if k8s_tutum_cnpg_superuser_password %}
  password: "{{ k8s_tutum_cnpg_superuser_password }}"
{% else %}
  # Auto-generated password
  password: "{{ lookup('password', '/dev/null chars=ascii_letters,digits length=24') }}"
{% endif %}
