#!/bin/bash
# Tutum Platform - Install Ansible Collection
# Generated by tutum_offline_bundle role
#
# This script installs the Tutum CI/CD Ansible collection from the local bundle.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COLLECTION_DIR="${SCRIPT_DIR}/../collection"

echo "==========================================="
echo "  Tutum Platform - Install Ansible Collection"
echo "==========================================="
echo ""

if ! command -v ansible-galaxy &> /dev/null; then
    echo "ERROR: ansible-galaxy is not installed or not in PATH"
    echo "Please install Ansible first: pip install ansible"
    exit 1
fi

echo "Looking for collection in: ${COLLECTION_DIR}"
echo ""

# Find the collection tarball
COLLECTION_FILE=$(find "${COLLECTION_DIR}" -name "{{ k8s_tutum_offline_collection_name | replace('.', '-') }}-*.tar.gz" 2>/dev/null | head -1)

if [ -z "${COLLECTION_FILE}" ]; then
    # Try alternative naming
    COLLECTION_FILE=$(find "${COLLECTION_DIR}" -name "*.tar.gz" 2>/dev/null | head -1)
fi

if [ -z "${COLLECTION_FILE}" ]; then
    echo "ERROR: Could not find collection tarball in ${COLLECTION_DIR}"
    echo "Contents of collection directory:"
    ls -la "${COLLECTION_DIR}" || true
    exit 1
fi

echo "Found collection: ${COLLECTION_FILE}"
echo ""

# Install the collection
echo "Installing collection..."
ansible-galaxy collection install "${COLLECTION_FILE}" --force

echo ""
echo "==========================================="
echo "  Collection installed successfully!"
echo "==========================================="
echo ""
echo "Verify installation:"
echo "  ansible-galaxy collection list | grep {{ k8s_tutum_offline_collection_name }}"
echo ""
echo "You can now run installation playbooks:"
echo "  ansible-playbook playbooks/install-tutum-k8s.yml -i your-inventory.ini"
